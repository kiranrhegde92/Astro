# ─────────────────────────────────────────────────────────────────────────────
# CosmicSelf — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# This file (.env.example) has no real values — it is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Your apps → Web app → Config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── RevenueCat ────────────────────────────────────────────────────────────────
# RevenueCat Dashboard → Project Settings → API Keys
# iOS key starts with appl_, Android key starts with goog_
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── AdMob App IDs ─────────────────────────────────────────────────────────────
# AdMob Console → Apps → App ID (used in app.config.js plugins section)
# Format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# Leave the test IDs below during development:
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# ── AdMob Rewarded Ad Unit IDs ────────────────────────────────────────────────
# AdMob Console → Apps → Ad units → Rewarded
# Format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=

# ── AdMob Mode ────────────────────────────────────────────────────────────────
# Set to "true" only in production builds.
EXPO_PUBLIC_ADMOB_USE_PRODUCTION=false

# Google Sign-In
# Firebase Console / Google Cloud Console -> OAuth 2.0 Client IDs
# Web client ID is required so Google Sign-In can return an ID token for Firebase Auth.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
